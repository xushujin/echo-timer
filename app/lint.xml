<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
      adaptive-icon 必须放在 -v26 目录里，AAPT 不接受无版本限定的 mipmap-anydpi 中的
      <adaptive-icon>；虽然 minSdk 已是 26，这条 ObsoleteSdkInt 提示属于误报。
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
      OldTargetApi：项目有意停在 targetSdk 35（按 35 做完适配与验证），
      但 CI 镜像通常预装更新的 Android platform，lint 会提示"未使用最新 API"。
      这里显式忽略；以后决定升级 targetSdk 时，删掉本条即可重新暴露该提示。
    -->
    <issue id="OldTargetApi" severity="ignore" />
</lint>
