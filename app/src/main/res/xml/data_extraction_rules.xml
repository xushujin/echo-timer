<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/换机迁移范围：只包含计时数据库与设置。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="echotimer.db" />
        <include domain="sharedpref" path="echotimer_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="echotimer.db" />
        <include domain="sharedpref" path="echotimer_settings.xml" />
    </device-transfer>
</data-extraction-rules>
